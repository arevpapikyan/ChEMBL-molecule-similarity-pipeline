# S3
S3_BUCKET=<your-s3-bucket>
S3_PREFIX=<your/prefix>
S3_REGION=<your-region>

# AWS credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Data warehouse (Postgres)
DWH_URL=postgresql://<user>:<password>@host.docker.internal:5432/<database>?sslmode=require
# Same password again, for the psql DDL step (psql has no --password flag).
PGPASSWORD=<password>

# Pipeline parameters
N_SOURCE_MOLECULES=100
TOP_K=10
RANDOM_SEED=42

# Fingerprint corpus size
FINGERPRINT_SAMPLE_SIZE=
# Set to 1 to ignore the fingerprint manifest and recompute from scratch.
FINGERPRINTS_FORCE_RECOMPUTE=

# Ingestion tuning (all optional -- leave blank to use the built-in defaults)
INGEST_MIN_FREE_BYTES=
INGEST_DOWNLOAD_MAX_ATTEMPTS=
INGEST_DOWNLOAD_RETRY_DELAY=
INGEST_DOWNLOAD_SOCKET_TIMEOUT=
INGEST_EXTRACTION_TIMEOUT_SECONDS=
PYSTOW_HOME=

# Teams failure notifications
TEAMS_WEBHOOK_URL=
TEAMS_ALERTS_OPTIONAL=false

# Airflow
AIRFLOW__API_AUTH__JWT_SECRET=
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
DAG_OWNER=<your-name>

# SSM tunnel
AWS_REGION=<your-region>
AWS_PROFILE=<your-sso-profile>
SSM_TARGET=<your-bastion-instance-id>
DWH_HOST=<your-rds-endpoint>
DWH_PORT=5432

AWS_CONFIG_DIR=<absolute-path-to-your-.aws>
